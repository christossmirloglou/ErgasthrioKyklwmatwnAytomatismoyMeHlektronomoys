Public Class Termatikos_ActiveImage
    Inherits TerminalSwitchTemplate
    '***************************************************************************************************************************************
    ' nameImage
    'Ορίζει την εικόνα που θα πρέπει να φαίνεται στο αντικείμενο
    '***************************************************************************************************************************************
    Public Overrides Sub nameImage()
        'Αν ζητηθεί η δημιουργία αντικειμένου κατά τη διάρκεια του Edit, τότε εδώ θα ορίσουμε αν θα έχει την κανονική του εικόνα ή την εικόνα με το σύμβολο
        Select Case useStandardSymbolsDuringEdit
            Case False                              'Κανονική εικόνα
                Me.Image = My.Resources.Terminal_Switch
            Case True                               'Εικόνα με σύμβολο
                Me.Image = My.Resources.CTerminal_Switch
        End Select
    End Sub


    '***************************************************************************************************************************************
    ' Initialization
    'Χρησιμοποιείται κατά την φάση της δημιουργίας του αντικειμένου για να δώσει ορίσει τα ξεχωριστά χαρακτηριστικά του
    '***************************************************************************************************************************************
    Public Overrides Sub initialization()
        Me.information = "Τερματικός διακόπτης. Φέρει μια επαφή (11-12) κανονικά κλειστή και μια (23-24) κανονικά ανοιχτή (Normally Open). Σε κατάσταση ηρεμίας η επαφή NO είναι ανοιχτή και η ΝC κλειστή. Όταν πιεστεί ο αισθητήριος άξονας του τερματικού διακόπτη τότε η επαφή NO κλείνει και η NC ανοίγει."
        nameImage()

        Me.addScrew(31, 4, 15, 15, "11", "Αυτό είναι το ένα άκρο (έξοδος) της κανονικά κλειστής (Normally Closed) επαφής 11-12. Σε κατάσταση ηρεμίας η επαφή είναι κλειστή.", wirecolors(5), 0.5, Me)
        Me.addScrew(31, 102, 15, 15, "12", "Αυτό είναι το άλλο άκρο (έξοδος) της κανονικά κλειστής (Normally Closed) επαφής 11-12. Σε κατάσταση ηρεμίας η επαφή είναι κλειστή.", wirecolors(5), 1.5, Me)
        Me.addScrew(56, 4, 15, 15, "23", "Αυτό είναι το ένα άκρο (είσοδος) της κανονικά ανοιχτής (Normally Open) επαφής 23-24. Σε κατάσταση ηρεμίας η επαφή είναι ανοιχτή.", wirecolors(5), 0.5, Me)
        Me.addScrew(56, 102, 15, 15, "24", "Αυτό είναι το άλλο άκρο (έξοδος) της κανονικά ανοιχτής (Normally Open) επαφής 23-24. Σε κατάσταση ηρεμίας η επαφή είναι ανοιχτή.", wirecolors(5), 1.5, Me)

        Me.numberOfScrews = 3
        Me.setMoveBounds()
        setHotkeyNumber(1)
        Me.state = GlobalInfo.state.anenergo
        setHotKeyInformation(0, "Ενεργοποίηση του τερματικού διακόπτη")
        setHotKeyInformation(1, "Απενεργοποίηση του τερματικού διακόπτη")


    End Sub









    '***************************************************************************************************************************************
    ' What Am I
    'Επιστρέφει ένα String με τον τύπο του εξαρτήματος
    '***************************************************************************************************************************************
    Public Overrides Function whatami() As String
        Return "LIMIT SWITCH"
    End Function

    Public Overrides Function whatamiGreek() As String
        Return "Τερματικός διακόπτης"
    End Function





    '*****************************************************************************************************************************************************************************
    'RefreshImageForSimulation
    'Βασικά επιλέγει την σωστή εικόνα που θα πρέπει να προβληθεί κατά την προσομοίωση ανάλογα με το αν έχουμε επιλέξει να γίνει προσομοίωση με μορφή προβολή συμβόλων ή εξαρτημάτων
    '*****************************************************************************************************************************************************************************
    Public Overrides Sub Refresh_Image_Reference_For_Simulation()

        If state = GlobalInfo.state.anenergo Then
            If SimulationSymbols Then Me.Image = My.Resources.CTerminal_Switch Else Me.Image = My.Resources.Terminal_Switch
        Else
            If SimulationSymbols Then Me.Image = My.Resources.CTerminal_Switch_Active Else Me.Image = My.Resources.Terminal_Switch_Active

        End If
    End Sub


    '***************************************************************************************************************************************
    ' State Has Changed
    'Κανει τις απαραίτητες αλλαγές όταν αλλάζει η κατάσταση του αντικειμένου
    '***************************************************************************************************************************************
    Public Overrides Sub state_has_changed()
        If soundon Then My.Computer.Audio.Play(My.Resources.Click_Sound, AudioPlayMode.Background)
        Refresh_Image_Reference_For_Simulation()

    End Sub




End Class
